# Copy to .env (gitignored) and fill in from Supabase > Project Settings.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only. Bypasses RLS: never ship it to the frontend or commit it.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional, only used by apply_schema.py. URL-encode special characters in the password ('@' -> '%40').
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres
