# Copy to .env (gitignored) and fill in from Supabase > Project Settings.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only. Bypasses RLS: never ship it to the frontend or commit it.
SUPABASE_SECRET_KEY=sb_secret_...
# Needed for requirement extraction and similar-project search.
OPENAI_API_KEY=sk-...
# If your key comes from a company LLM gateway/proxy, set its URL (the OpenAI SDK reads this automatically).
# OPENAI_BASE_URL=https://<gateway-host>/v1
# Optional overrides (defaults shown). Use the model names your gateway exposes.
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Blended software delivery rate used to cost the software plan (USD per person-day).
# SOFTWARE_DAY_RATE_USD=800
# Optional, only used by apply_schema.py. URL-encode special characters in the password ('@' -> '%40').
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres
